{
  "manifest_version": 2,
  "name": "PlayControl",
  "version": "0.5.0",
  "description": "Keyboard-driven YouTube playback control: seek, play/pause, bookmarks, segment replay, and a bookmark manager. Minimal page footprint, PotPlayer-style on-screen text.",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "playcontrol@realserverfeel",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "tabs",
    "ws://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["src/defaults.js", "src/storage.js", "src/shortcuts.js", "src/bridge.js", "src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/defaults.js", "src/storage.js", "src/shortcuts.js", "src/content.js"],
      "css": ["src/osd.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "PlayControl",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
